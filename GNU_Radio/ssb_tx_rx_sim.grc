options:
  parameters:
    author: Bloc 1 - simulations pédagogiques
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Message -> filtre de Hilbert à 48 kHz (x + j.H{x}) -> rééchantillonneur -> BLU supérieure en bande de base -> FI -> bruit -> OL -> filtre passe-bande complexe 300-3000 Hz -> partie réelle
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: ssb_tx_rx_sim
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'BLU : émetteur (Hilbert / Hartley) et récepteur en simulation'
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
