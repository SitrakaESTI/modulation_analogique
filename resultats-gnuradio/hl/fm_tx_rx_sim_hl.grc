options:
  parameters:
    author: Bloc 1 - simulations pédagogiques
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Message -> rééchantillonneur -> modulateur de fréquence (2.pi.df/fs)
      -> FI -> bruit -> OL -> filtre/décimation -> démodulateur en quadrature -> filtre
      audio
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: fm_tx_rx_sim_hl
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: run
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'FM : émetteur et récepteur en simulation'
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: import_math
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: import math
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 16
    rotation: 0
    state: enabled
- name: audio_rate
  id: variable
  parameters:
    alias: ''
    comment: ''
    value: '48000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 189
    - 16
    rotation: 0
    state: enabled
- name: interp
  id: variable
  parameters:
    alias: ''
    comment: ''
    value: '10'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 337
    - 16
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    alias: ''
    comment: ''
    value: audio_rate*interp
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 485
    - 16
    rotation: 0
    state: enabled
- name: fc
  id: variable
  parameters:
    comment: ''
    value: 10e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 691
    - 16
    rotation: 0
    state: enabled
- name: noise_amp
  id: variable
  parameters:
    comment: ''
    value: '0.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 973
    - 16
    rotation: 0
    state: enabled
- name: lo_phase
  id: variable
  parameters:
    comment: ''
    value: '-2.5'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1243
    - 16
    rotation: 0
    state: enabled
- name: fm
  id: variable
  parameters:
    comment: ''
    value: '1000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1525
    - 16
    rotation: 0
    state: enabled
- name: msg
  id: analog_sig_source_x
  parameters:
    alias: ''
    comment: ''
    affinity: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    type: float
    samp_rate: audio_rate
    waveform: analog.GR_COS_WAVE
    freq: fm
    amp: '1'
    offset: '0'
    phase: '0'
    showports: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 190
    rotation: 0
    state: enabled
- name: throttle
  id: blocks_throttle
  parameters:
    alias: ''
    comment: ''
    affinity: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    type: float
    samples_per_second: audio_rate
    vlen: '1'
    ignoretag: 'True'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 330
    - 220
    rotation: 0
    state: enabled
- name: resampler
  id: rational_resampler_xxx
  parameters:
    alias: ''
    comment: ''
    affinity: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    type: fff
    interp: interp
    decim: '1'
    taps: '[]'
    fbw: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 625
    - 350
    rotation: 0
    state: enabled
- name: deviation
  id: variable
  parameters:
    comment: ''
    value: 5e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1801
    - 16
    rotation: 0
    state: enabled
- name: fm_mod
  id: analog_frequency_modulator_fc
  parameters:
    alias: ''
    comment: ''
    affinity: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    sensitivity: 2*math.pi*deviation/samp_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 908
    - 358
    rotation: 0
    state: enabled
- name: lo_tx
  id: analog_sig_source_x
  parameters:
    alias: ''
    comment: ''
    affinity: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    type: complex
    samp_rate: samp_rate
    waveform: analog.GR_COS_WAVE
    freq: fc
    amp: '1'
    offset: '0'
    phase: '0'
    showports: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 908
    - 488
    rotation: 0
    state: enabled
- name: mix_tx
