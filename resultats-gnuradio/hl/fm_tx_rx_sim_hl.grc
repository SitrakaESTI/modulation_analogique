- name: lpf_rx
  id: low_pass_filter
  parameters:
    alias: ''
    comment: ''
    affinity: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    type: fir_filter_ccf
    decim: interp
    interp: '1'
    gain: '1'
    samp_rate: samp_rate
    cutoff_freq: min(deviation + 3e3, 22e3)
    width: 2e3
    win: window.WIN_HAMMING
    beta: '6.76'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 702
    - 1249
    rotation: 0
    state: enabled
- name: fm_demod
  id: analog_quadrature_demod_cf
  parameters:
    alias: ''
    comment: ''
    affinity: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    gain: audio_rate/(2*math.pi*deviation)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1100
    - 1287
    rotation: 0
    state: enabled
- name: lpf_audio
